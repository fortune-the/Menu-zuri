<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MenuZuri — Beautiful Digital Menus for Nairobi Businesses</title>
<meta name="description" content="Digital menus for Nairobi businesses. Scan, browse, order — no app needed. Set up in 24 hours.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@500&display=swap" rel="stylesheet">
<style>
  :root{
    --forest:#0B3D2E;
    --forest-dark:#082B20;
    --gold:#E8A33D;
    --gold-light:#F3C77C;
    --cream:#FBF6EC;
    --ink:#16241D;
    --line: rgba(11,61,46,0.12);
  }
  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    font-family:'Inter',sans-serif;
    color:var(--ink);
    background:var(--cream);
    -webkit-font-smoothing:antialiased;
  }
  h1,h2,h3,.display{
    font-family:'Sora',sans-serif;
  }
  .mono{ font-family:'JetBrains Mono',monospace; letter-spacing:0.02em; }
  a{color:inherit;}
  .wrap{ max-width:1120px; margin:0 auto; padding:0 24px; }
  .btn{
    display:inline-flex; align-items:center; gap:8px;
    padding:14px 26px; border-radius:999px; font-weight:600;
    font-size:15px; text-decoration:none; border:1px solid transparent;
    transition:transform .15s ease, box-shadow .15s ease, background .15s ease;
    cursor:pointer;
  }
  .btn:focus-visible{ outline:3px solid var(--gold); outline-offset:3px; }
  .btn-primary{ background:var(--gold); color:var(--forest-dark); }
  .btn-primary:hover{ transform:translateY(-2px); box-shadow:0 10px 24px rgba(232,163,61,0.35); }
  .btn-ghost{ background:transparent; color:var(--cream); border-color:rgba(251,246,236,0.35); }
  .btn-ghost:hover{ background:rgba(251,246,236,0.1); }
  .btn-dark{ background:var(--forest); color:var(--cream); }
  .btn-dark:hover{ transform:translateY(-2px); box-shadow:0 10px 24px rgba(11,61,46,0.25); }

  /* pattern strip - kitenge-inspired geometric border, used sparingly as signature */
  .kitenge{
    height:10px;
    background: repeating-linear-gradient(115deg,
      var(--gold) 0 10px,
      var(--forest) 10px 20px,
      var(--gold-light) 20px 30px,
      var(--forest-dark) 30px 40px);
  }

  header{ position:sticky; top:0; z-index:50; background:var(--forest-dark); }
  nav{ display:flex; align-items:center; justify-content:space-between; padding:18px 0; }
  .logo{ display:flex; align-items:center; gap:10px; color:var(--cream); font-weight:800; font-size:19px; }
  .logo-badge{ width:34px; height:34px; border-radius:9px; background:var(--gold); display:flex; align-items:center; justify-content:center; font-size:16px; }
  .navlinks{ display:flex; gap:32px; list-style:none; margin:0; padding:0; }
  .navlinks a{ color:rgba(251,246,236,0.75); text-decoration:none; font-size:14px; font-weight:500; }
  .navlinks a:hover{ color:var(--cream); }
  .navcta{ display:flex; align-items:center; gap:14px; }
  .navlinks-mobile{ display:none; }
  @media(max-width:820px){
    .navlinks{ display:none; }
    .navcta .btn-ghost{ display:none; }
  }

  /* HERO */
  .hero{ background:var(--forest-dark); color:var(--cream); padding:72px 0 0; position:relative; overflow:hidden; }
  .hero-grid{ display:grid; grid-template-columns:1.1fr 0.9fr; gap:56px; align-items:center; padding-bottom:64px;}
  @media(max-width:900px){ .hero-grid{ grid-template-columns:1fr; } }
  .eyebrow{ display:inline-flex; align-items:center; gap:8px; background:rgba(232,163,61,0.14); border:1px solid rgba(232,163,61,0.4); color:var(--gold-light); padding:7px 14px; border-radius:999px; font-size:13px; font-weight:600; margin-bottom:22px; }
  .hero h1{ font-size:clamp(34px,5vw,54px); line-height:1.06; font-weight:800; margin:0 0 20px; letter-spacing:-0.02em; }
  .hero h1 em{ font-style:normal; color:var(--gold-light); }
  .hero p.lead{ font-size:18px; line-height:1.6; color:rgba(251,246,236,0.72); max-width:480px; margin:0 0 32px; }
  .hero-ctas{ display:flex; gap:14px; flex-wrap:wrap; margin-bottom:40px; }
  .hero-stats{ display:flex; gap:36px; flex-wrap:wrap; border-top:1px solid rgba(251,246,236,0.14); padding-top:26px; }
  .stat b{ display:block; font-family:'Sora',sans-serif; font-size:26px; color:var(--gold-light); }
  .stat span{ font-size:13px; color:rgba(251,246,236,0.6); }

  /* Phone mockup - signature element */
  .phone-wrap{ display:flex; justify-content:center; }
  .phone{
    width:290px; background:var(--cream); border-radius:34px; padding:14px;
    box-shadow:0 40px 80px rgba(0,0,0,0.45), 0 0 0 8px rgba(251,246,236,0.06);
    transform:rotate(2deg);
  }
  .phone-screen{ background:#fff; border-radius:22px; overflow:hidden; }
  .phone-status{ height:26px; background:var(--forest); }
  .phone-head{ background:var(--forest); color:var(--cream); padding:16px 16px 20px; }
  .phone-head .tag{ font-size:11px; background:var(--gold); color:var(--forest-dark); display:inline-block; padding:3px 9px; border-radius:999px; font-weight:700; margin-bottom:8px; }
  .phone-head h3{ margin:0; font-size:19px; }
  .phone-head p{ margin:4px 0 0; font-size:12px; color:rgba(251,246,236,0.7); }
  .phone-body{ padding:14px 16px 20px; }
  .phone-section-title{ font-size:11px; text-transform:uppercase; letter-spacing:0.08em; color:var(--forest); font-weight:700; margin:14px 0 8px; }
  .menu-item{ display:flex; justify-content:space-between; align-items:flex-start; gap:10px; padding:9px 0; border-bottom:1px dashed var(--line); }
  .menu-item:last-child{ border-bottom:none; }
  .menu-item .em{ font-size:20px; margin-right:8px; }
  .menu-item .name{ font-weight:700; font-size:13.5px; }
  .menu-item .desc{ font-size:11.5px; color:#6b7a72; margin-top:2px; }
  .menu-item .price{ font-family:'JetBrains Mono',monospace; font-weight:600; font-size:12.5px; color:var(--forest); white-space:nowrap; }
  .qr-chip{ position:absolute; right:-18px; bottom:60px; background:var(--gold); color:var(--forest-dark); padding:10px 14px; border-radius:14px; font-size:12px; font-weight:700; box-shadow:0 14px 30px rgba(0,0,0,0.3); display:flex; align-items:center; gap:8px; }
  @media(max-width:900px){ .qr-chip{ display:none; } }

  section{ padding:88px 0; }
  .section-head{ max-width:640px; margin-bottom:52px; }
  .eyebrow-dark{ color:var(--forest); font-weight:700; font-size:13px; text-transform:uppercase; letter-spacing:0.08em; margin-bottom:10px; }
  .section-head h2{ font-size:clamp(26px,3.6vw,38px); margin:0 0 14px; letter-spacing:-0.01em; }
  .section-head p{ font-size:16px; color:#4d5c53; line-height:1.6; margin:0; }

  /* HOW IT WORKS - timeline since it's a real sequence */
  .timeline{ position:relative; }
  .tl-line{ position:absolute; left:27px; top:8px; bottom:8px; width:2px; background:var(--line); }
  @media(max-width:700px){ .tl-line{ display:none; } }
  .tl-item{ display:grid; grid-template-columns:56px 1fr; gap:24px; margin-bottom:36px; }
  .tl-num{ width:56px; height:56px; border-radius:16px; background:var(--forest); color:var(--gold-light); display:flex; align-items:center; justify-content:center; font-size:22px; z-index:1; }
  .tl-item h3{ margin:6px 0 6px; font-size:19px; }
  .tl-item p{ margin:0; color:#4d5c53; line-height:1.6; font-size:15px; max-width:520px; }

  /* PRICING */
  .pricing-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
  @media(max-width:900px){ .pricing-grid{ grid-template-columns:1fr; } }
  .plan{ background:#fff; border:1px solid var(--line); border-radius:20px; padding:32px 28px; display:flex; flex-direction:column; }
  .plan.popular{ border-color:var(--gold); box-shadow:0 18px 40px rgba(11,61,46,0.1); position:relative; }
  .plan-badge{ position:absolute; top:-13px; left:28px; background:var(--gold); color:var(--forest-dark); font-size:12px; font-weight:700; padding:5px 12px; border-radius:999px; }
  .plan-name{ font-weight:700; font-size:15px; color:var(--forest); margin-bottom:14px; }
  .plan-price{ font-family:'Sora',sans-serif; font-size:38px; font-weight:800; margin-bottom:2px; }
  .plan-cycle{ font-size:13px; color:#6b7a72; margin-bottom:4px; }
  .plan-setup{ font-size:13px; color:#6b7a72; margin-bottom:24px; }
  .plan ul{ list-style:none; padding:0; margin:0 0 28px; flex:1; }
  .plan li{ display:flex; gap:10px; align-items:flex-start; font-size:14.5px; padding:7px 0; color:#33423a; }
  .plan li::before{ content:"✓"; color:var(--forest); font-weight:700; }

  /* WHY US */
  .why-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:28px; }
  @media(max-width:900px){ .why-grid{ grid-template-columns:1fr 1fr; } }
  @media(max-width:600px){ .why-grid{ grid-template-columns:1fr; } }
  .why-card{ padding:6px 0; }
  .why-icon{ width:46px; height:46px; border-radius:12px; background:rgba(11,61,46,0.08); display:flex; align-items:center; justify-content:center; font-size:21px; margin-bottom:14px; }
  .why-card h3{ font-size:16.5px; margin:0 0 8px; }
  .why-card p{ margin:0; font-size:14px; color:#4d5c53; line-height:1.55; }

  /* TESTIMONIALS */
  .testi-grid{ display:grid; grid-template-columns:repeat(3,1fr); gap:24px; }
  @media(max-width:900px){ .testi-grid{ grid-template-columns:1fr; } }
  .testi{ background:#fff; border:1px solid var(--line); border-radius:18px; padding:26px; }
  .stars{ color:var(--gold); letter-spacing:2px; margin-bottom:14px; font-size:14px; }
  .testi p.quote{ font-size:14.5px; line-height:1.6; color:#33423a; margin:0 0 20px; }
  .testi-person{ display:flex; align-items:center; gap:12px; }
  .avatar{ width:38px; height:38px; border-radius:999px; background:var(--forest); color:var(--gold-light); display:flex; align-items:center; justify-content:center; font-weight:700; font-size:13px; }
  .testi-person b{ display:block; font-size:14px; }
  .testi-person span{ font-size:12.5px; color:#6b7a72; }

  /* CTA BAND */
  .cta-band{ background:var(--forest); color:var(--cream); text-align:center; padding:80px 24px; }
  .cta-band h2{ font-size:clamp(26px,4vw,38px); margin:0 0 14px; }
  .cta-band p{ color:rgba(251,246,236,0.72); margin:0 0 32px; font-size:16px; }

  /* CONTACT */
  .contact-grid{ display:grid; grid-template-columns:0.9fr 1.1fr; gap:56px; }
  @media(max-width:900px){ .contact-grid{ grid-template-columns:1fr; } }
  .contact-item{ display:flex; gap:14px; margin-bottom:22px; }
  .contact-item .ic{ width:42px; height:42px; border-radius:11px; background:rgba(11,61,46,0.08); display:flex; align-items:center; justify-content:center; font-size:18px; flex-shrink:0; }
  .contact-item b{ display:block; font-size:14px; }
  .contact-item a, .contact-item span.val{ font-size:14.5px; color:#4d5c53; text-decoration:none; }
  form{ background:#fff; border:1px solid var(--line); border-radius:20px; padding:32px; }
  .field{ margin-bottom:18px; }
  .field label{ display:block; font-size:13px; font-weight:600; margin-bottom:6px; color:var(--forest); }
  .field input, .field select, .field textarea{
    width:100%; padding:12px 14px; border-radius:10px; border:1px solid var(--line);
    font-family:'Inter',sans-serif; font-size:14.5px; background:var(--cream); color:var(--ink);
  }
  .field input:focus, .field select:focus, .field textarea:focus{ outline:2px solid var(--forest); outline-offset:1px; }
  .field-row{ display:grid; grid-template-columns:1fr 1fr; gap:14px; }
  @media(max-width:520px){ .field-row{ grid-template-columns:1fr; } }
  .form-note{ font-size:12.5px; color:#6b7a72; margin-top:10px; }

  footer{ background:var(--forest-dark); color:rgba(251,246,236,0.65); padding:56px 0 28px; }
  .foot-grid{ display:grid; grid-template-columns:2fr 1fr 1fr; gap:40px; margin-bottom:40px; }
  @media(max-width:700px){ .foot-grid{ grid-template-columns:1fr; } }
  .foot-logo{ display:flex; align-items:center; gap:10px; color:var(--cream); font-weight:800; font-size:18px; margin-bottom:12px; }
  footer h4{ color:var(--cream); font-size:13px; text-transform:uppercase; letter-spacing:0.06em; margin:0 0 14px; }
  footer ul{ list-style:none; padding:0; margin:0; }
  footer li{ margin-bottom:9px; font-size:14px; }
  footer a{ text-decoration:none; color:inherit; }
  footer a:hover{ color:var(--cream); }
  .foot-bottom{ border-top:1px solid rgba(251,246,236,0.12); padding-top:22px; font-size:12.5px; }

  ::selection{ background:var(--gold); color:var(--forest-dark); }
  @media (prefers-reduced-motion: reduce){ *{ transition:none !important; scroll-behavior:auto !important; } }
</style>
</head>
